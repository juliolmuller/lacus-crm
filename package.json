{
  "name": "lacus-crm",
  "version": "auto",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.4",
  "author": "Lacus Solutions",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "check": "bun run typecheck && bun run lint && bun run test",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rollback": "bun scripts/rollback.ts",
    "db:seed": "bun scripts/seed.ts",
    "icons": "bun scripts/generate-icons.ts",
    "db:import": "bun scripts/import-data.ts",
    "audit:deps": "bun audit --audit-level=high",
    "release": "semantic-release"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.26",
