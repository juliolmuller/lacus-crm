    "google-auth-library": "11.3.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "nuqs": "2.10.3",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
