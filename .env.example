DATABASE_URL=                  # local: postgres://lacus:lacus@localhost:54329/lacus_crm (docker compose up -d)
DATABASE_URL_UNPOOLED=         # Neon: conexão direta, usada nas migrations
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
OWNER_VERCEL_USER_ID=          # "sub" do Sign in with Vercel; em dev, o login negado mostra o valor
OWNER_EMAIL=                   # fallback quando o sub não está preenchido (e-mail verificado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=          # openssl rand -base64 32
CRON_SECRET=                   # >= 16 caracteres aleatórios
APP_TIMEZONE=America/Sao_Paulo
NEXT_PUBLIC_APP_URL=http://localhost:3000
E2E_AUTH_BYPASS=0
